{
  "name": "good-skills",
  "version": "1.0.2",
  "description": "Self-developed AI agent skills with daily push notifications (Bark + Email)",
  "bin": {
    "good-skills": "bin/good-skills.js"
  },
  "files": [
    "bin/",
    "scripts/run_skill.sh",
    "scripts/archive.sh",
    "skills/**/*.py",
    "skills/**/*.md",
    "skills/**/*.json",
    "skills/**/*.txt",
    "skills/**/*.sh",
    "install.sh",
    "install-remote.sh",
    "CLAUDE.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunchendd/good_skills.git"
  },
  "homepage": "https://github.com/sunchendd/good_skills#readme",
  "bugs": {
    "url": "https://github.com/sunchendd/good_skills/issues"
  },
  "scripts": {
    "setup": "bash install.sh",
    "fitness": "bash scripts/run_skill.sh skills/super-fitness/run_fitness.py",
    "wardrobe": "bash scripts/run_skill.sh skills/super-wardrobe/run_wardrobe.py",
    "newsletter": "bash scripts/run_skill.sh skills/daily-newsletter/run_daily_newsletter.py --now",
    "arxiv": "bash scripts/run_skill.sh skills/arxiv-daily/run_arxiv_daily.py",
    "vibe": "bash scripts/run_skill.sh skills/vibe-daily/run_vibe_daily.py",
    "weekly": "bash scripts/run_skill.sh skills/weekly-report/run_weekly_report.py",
    "digest": "bash scripts/run_skill.sh skills/daily-digest/run_daily_digest.py",
    "archive": "bash scripts/archive.sh",
    "all": "npm run fitness && npm run wardrobe && npm run newsletter && npm run arxiv && npm run vibe"
  },
  "keywords": [
    "ai",
    "productivity",
    "daily-newsletter",
    "bark",
    "automation"
  ],
  "author": "sunchendong",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module"
}
