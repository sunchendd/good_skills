# Good Skills - Cron Jobs
# Install with: crontab crontab.example
# Or append with: crontab -l | cat - crontab.example | crontab -

GOOD_SKILLS_HOME=/Users/sunchendong/Desktop/good_skills

# Daily Newsletter - 每天早上 7:00
0 7 * * * cd $GOOD_SKILLS_HOME && python3 skills/daily-newsletter/run_daily_newsletter.py >> /tmp/good-skills-newsletter.log 2>&1

# arXiv Daily - 每天早上 7:30
30 7 * * * cd $GOOD_SKILLS_HOME && python3 skills/arxiv-daily/run_arxiv_daily.py >> /tmp/good-skills-arxiv.log 2>&1

# Vibe Daily - 每天早上 8:00
0 8 * * * cd $GOOD_SKILLS_HOME && python3 skills/vibe-daily/run_vibe_daily.py >> /tmp/good-skills-vibe.log 2>&1

# Super Wardrobe - 每天早上 7:15
15 7 * * * cd $GOOD_SKILLS_HOME && python3 skills/super-wardrobe/run_wardrobe.py >> /tmp/good-skills-wardrobe.log 2>&1

# Super Fitness - 每天早上 6:30
30 6 * * * cd $GOOD_SKILLS_HOME && python3 skills/super-fitness/run_fitness.py >> /tmp/good-skills-fitness.log 2>&1

# Daily Digest - 每天晚上 22:00 (汇总当日所有 skill 输出)
0 22 * * * cd $GOOD_SKILLS_HOME && python3 skills/daily-digest/run_daily_digest.py >> /tmp/good-skills-digest.log 2>&1

# Weekly Report - 每周日晚上 21:00
0 21 * * 0 cd $GOOD_SKILLS_HOME && python3 skills/weekly-report/run_weekly_report.py >> /tmp/good-skills-weekly.log 2>&1
