# Copy to .env and fill in. Only the skills you use need their keys.
# (coding-guidelines, humanizer-zh, patent-*, skill-creator need none.)

# LLM API — used by skills for scoring / summaries (daily-newsletter, arxiv-daily, etc.)
DEEPSEEK_API_KEY=

# GitHub API — github-watcher, daily-digest
GITHUB_TOKEN=

# iOS push notifications via Bark
BARK_TOKEN=

# QQ mail SMTP (sender + auth)
EMAIL_SENDER=
EMAIL_RECIPIENTS=
QQ_EMAIL_PASSWORD=
