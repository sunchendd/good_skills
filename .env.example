# Good Skills - Environment Variables
# Copy to .env and fill in your values

# Repo root path (set automatically by install.sh)
GOOD_SKILLS_HOME=/path/to/good-skills

# LLM API (DeepSeek via OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Email (SMTP)
SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Bark Push Notifications
BARK_KEY=
BARK_SERVER=https://api.day.app

# Serper.dev API (patent-search)
SERPER_API_KEY=

# Weather API (super-wardrobe)
WEATHER_API_KEY=

# SiYuan Notes (optional)
SIYUAN_API_URL=http://127.0.0.1:6806
SIYUAN_API_TOKEN=
